# Tally server configuration — copy to .env and fill in.
#   cp .env.example .env
#
# After filling this in, connect Google Drive once:
#   docker compose run --rm tally auth
# It prints a URL and an 8-character code; open the URL on any device, sign in
# with the SAME Google account the phone app will use, and enter the code.

# ---------------------------------------------------------------------------
# Google Drive sync (required)
# ---------------------------------------------------------------------------
# Google Cloud console → APIs & Services → Credentials → Create credentials →
# OAuth client ID → application type "TVs and Limited Input devices".
# Use THE SAME client id/secret in the phone app: one client, one account.
#
# IMPORTANT: set the OAuth consent screen to "In production". While it is in
# "Testing" Google expires refresh tokens after 7 days and sync dies a week
# after setup. The only scope used is drive.file, which is non-sensitive, so
# publishing needs no verification review.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the refresh token is stored. Must be on the mounted volume so it
# survives image rebuilds. Written with mode 0600 by `tally auth`.
TOKEN_PATH=/data/google-token.json

# Name of the folder created in the Drive root to hold the snapshot files.
DRIVE_FOLDER_NAME=Tally

# How often the server polls Drive for the phone's snapshot, in seconds.
# Polling is not optional: there is no inbound API, so this is the only way
# the bot learns about transactions entered on the phone.
SYNC_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Telegram bot
# ---------------------------------------------------------------------------
# Bot token from @BotFather. Leave empty to run sync-only (no bot).
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user ids allowed to use the bot (get yours from
# @userinfobot). Example: TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=

# ---------------------------------------------------------------------------
# Local
# ---------------------------------------------------------------------------
# Port of the health endpoint inside the container (compose binds it to
# 127.0.0.1 only — nothing needs to reach this server from outside).
PORT=8080

# SQLite database path (compose mounts ./data at /data).
DB_PATH=/data/tally.db

# ISO-4217 currency code used when the database is first created.
DEFAULT_CURRENCY=USD

# Your IANA timezone. This decides what the bot's /today, /week and /month
# actually cover — leave it unset and "today" means today in UTC, which is
# wrong for everyone else. Example: Asia/Tashkent, Europe/Kyiv, America/Denver.
TZ=UTC
